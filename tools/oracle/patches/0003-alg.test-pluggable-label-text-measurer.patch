+package org.eclipse.elk.alg.test.framework.config;
+
+import java.awt.Graphics2D;
+import java.awt.geom.Rectangle2D;
+import java.awt.image.BufferedImage;
+
+import org.eclipse.elk.core.math.KVector;
+import org.eclipse.swt.SWT;
+
+/**
+ * The default {@link TextMeasurer}: chooses a font and calculates the space necessary to render the text with that
+ * font. This is the measurement {@link TestConfiguration} has always made, moved here unchanged. Its results depend
+ * on the fonts of the platform it runs on.
+ */
+public final class AwtTextMeasurer implements TextMeasurer {
+
+    /** The size of the font used to calculate the size of a label. */
+    private static final int DEFAULT_LABEL_FONT_SIZE = 10;
+
+    @Override
+    public KVector measure(final String text) {
+        // There seems to be a problem with SansSerif on Windows...
+        String fontName;
+        if (System.getProperty("os.name").toLowerCase().indexOf("win") >= 0) {
+            fontName = "Arial";
+        } else {
+            fontName = "SansSerif";
+        }
+
+        BufferedImage image = new BufferedImage(1, 1, BufferedImage.TYPE_INT_ARGB);
+
+        Graphics2D graphics = image.createGraphics();
+        graphics.setFont(new java.awt.Font(fontName, SWT.NORMAL, DEFAULT_LABEL_FONT_SIZE));
+
+        Rectangle2D rect = graphics.getFontMetrics().getStringBounds(text, graphics);
+        return new KVector(rect.getWidth(), rect.getHeight());
+    }
+
+}
