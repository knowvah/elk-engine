+package org.eclipse.elk.alg.test.framework.config;
+
+import org.eclipse.elk.core.math.KVector;
+
+/**
+ * Measures the text of a label for {@link TestConfiguration}, which gives a size to every label that has none before
+ * a test graph is laid out. Test seam (elk-engine oracle): the measurer is selected by the system property
+ * {@value #PROPERTY}. Unset, the test framework measures with AWT font metrics as it always did.
+ */
+public interface TextMeasurer {
+
+    /**
+     * The system property that selects the measurer: unset or {@code awt} measures with AWT font metrics
+     * ({@link AwtTextMeasurer}, the unchanged default), {@code fixed} measures with a fixed advance per character
+     * ({@link FixedAdvanceTextMeasurer}), which does not depend on the platform's fonts.
+     */
+    String PROPERTY = "org.eclipse.elk.alg.test.textMeasurer";
+
+    /**
+     * Computes the space the given text takes up.
+     * 
+     * @param text
+     *            the text to measure; neither {@code null} nor empty.
+     * @return the size of the text: {@code x} is its width, {@code y} its height.
+     */
+    KVector measure(String text);
+
+    /**
+     * Returns the measurer the system property {@value #PROPERTY} selects.
+     * 
+     * @return the measurer to use.
+     * @throws IllegalArgumentException
+     *             if the property holds a value other than {@code awt} or {@code fixed}.
+     */
+    static TextMeasurer fromSystemProperty() {
+        String value = System.getProperty(PROPERTY);
+        if (value == null || value.equals("awt")) {
+            return new AwtTextMeasurer();
+        } else if (value.equals("fixed")) {
+            return new FixedAdvanceTextMeasurer();
+        } else {
+            throw new IllegalArgumentException("Unknown text measurer: " + value);
+        }
+    }
+
+}
