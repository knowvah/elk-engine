+package org.eclipse.elk.alg.test.framework.config;
+
+import org.eclipse.elk.core.math.KVector;
+
+/**
+ * A {@link TextMeasurer} that does not depend on the platform: every character (UTF-16 code unit) advances the width
+ * by {@link #CHAR_ADVANCE}, and the height is always {@link #LINE_HEIGHT}. Line breaks are not special. Both constants
+ * are integers, so every result is exact. This is a normalized measure for comparing layouts across platforms, not a
+ * font model.
+ */
+public final class FixedAdvanceTextMeasurer implements TextMeasurer {
+
+    /** The width of a single character. */
+    public static final double CHAR_ADVANCE = 6.0;
+    /** The height of every text. */
+    public static final double LINE_HEIGHT = 12.0;
+
+    @Override
+    public KVector measure(final String text) {
+        return new KVector(text.length() * CHAR_ADVANCE, LINE_HEIGHT);
+    }
+
+}
