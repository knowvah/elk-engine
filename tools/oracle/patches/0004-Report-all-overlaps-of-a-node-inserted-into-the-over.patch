From 1bf1da95561140eb78d70d5dd747dd46803ead2a Mon Sep 17 00:00:00 2001
From: Scott Seely <scott@seely.io>
Date: Thu, 19 Nov 2026 14:29:49 -0600
Subject: [PATCH] Report all overlaps of a node inserted into the overlap
 scanline

When ScanlineOverlapCheck inserts a node into the scanline, it walks the
nodes on the scanline in the order of their left sides and stops at the
first node that does not overlap the inserted node once it has found an
overlap. The order of left sides does not support that: a node that
starts left of the inserted node and does not reach it can lie between
two nodes that overlap it, and so can the inserted node itself, which is
on the scanline and never overlaps itself. Every overlapping node behind
such a node was not reported. Of 20000 random sets of 4 to 15
rectangles, 10697 missed at least one overlapping pair.

Stop the walk instead at the first node whose left side is at or right
of the inserted node's right side, by the same fuzzy comparison the
overlap test uses. That node cannot overlap the inserted node, and as
the set is sorted by left sides, no later node can either. This keeps
the early exit the break was there for.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Scott Seely <scott@seely.io>
---
 .../common/spore/ScanlineOverlapCheck.java    | 11 ++--
 .../test/ScanlineOverlapRemovalTest.java      | 62 +++++++++++++++++++
 2 files changed, 67 insertions(+), 6 deletions(-)

diff --git a/plugins/org.eclipse.elk.alg.common/src/org/eclipse/elk/alg/common/spore/ScanlineOverlapCheck.java b/plugins/org.eclipse.elk.alg.common/src/org/eclipse/elk/alg/common/spore/ScanlineOverlapCheck.java
index caab191a..acd8d11b 100644
--- a/plugins/org.eclipse.elk.alg.common/src/org/eclipse/elk/alg/common/spore/ScanlineOverlapCheck.java
+++ b/plugins/org.eclipse.elk.alg.common/src/org/eclipse/elk/alg/common/spore/ScanlineOverlapCheck.java
@@ -167,7 +167,6 @@ public class ScanlineOverlapCheck {
             }
             
             // find overlaps with rectangles on current scanline and apply the overlapHandler
-            boolean overlapsFound = false;
             for (Node other : intervalsSortLeft) { // have to start with first(left side) node because the 
                 if (overlap(p.node, other)) {       // last(right side) that does not overlap is not necessarily the
                     overlapHandler.handle(p.node, other); // first candidate to overlap (there could be a wide node).
@@ -175,11 +174,11 @@ public class ScanlineOverlapCheck {
                     svg.g("o").addRect(other.rect, "stroke=\"none\" fill=\"red\" opacity=\"0.18\"");
                     svg.g("e").addLine(p.node.vertex.x, p.node.vertex.y, other.vertex.x, other.vertex.y, 
                             "stroke=\"blue\"");
-                    overlapsFound = true;
-                } else {
-                    if (overlapsFound) {
-                        break; // there cannot be any more overlaps because the set is sorted
-                    }
+                } else if (DoubleMath.fuzzyCompare(other.rect.x, p.node.rect.x + p.node.rect.width,
+                        InternalProperties.FUZZINESS) >= 0) {
+                    // other starts at or right of the inserted node's right side; the set is sorted by left
+                    // sides, so no later node can overlap the inserted node either
+                    break;
                 }
             }
         }
diff --git a/test/org.eclipse.elk.alg.spore.test/src/org/eclipse/elk/alg/spore/test/ScanlineOverlapRemovalTest.java b/test/org.eclipse.elk.alg.spore.test/src/org/eclipse/elk/alg/spore/test/ScanlineOverlapRemovalTest.java
index fc952ac4..152285ef 100644
--- a/test/org.eclipse.elk.alg.spore.test/src/org/eclipse/elk/alg/spore/test/ScanlineOverlapRemovalTest.java
+++ b/test/org.eclipse.elk.alg.spore.test/src/org/eclipse/elk/alg/spore/test/ScanlineOverlapRemovalTest.java
