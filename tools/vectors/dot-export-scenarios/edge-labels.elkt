node a {
  layout [ size: 30, 30 ]
}
node b {
  layout [ position: 100, 100 size: 30, 30 ]
}
edge center : a -> b {
  label "c1" { layout [ size: 20, 10 ] edgeLabels.placement: CENTER font.^size: 10 font.name: "Arial" }
  label "c2" { layout [ size: 30.5, 12 ] edgeLabels.placement: CENTER font.^size: 12 font.name: "Times" }
}
edge headTail : a -> b {
  label "h1" { layout [ size: 10, 8 ] edgeLabels.placement: HEAD font.^size: 9 font.name: "Courier" }
  label "t1" { layout [ size: 12, 9 ] edgeLabels.placement: TAIL font.^size: 14 }
  label "h2" { layout [ size: 16, 7.5 ] edgeLabels.placement: HEAD font.^size: 20 }
}
edge mixed : b -> a {
  label "head first" { edgeLabels.placement: HEAD font.^size: 8 font.name: "Mono" }
  label "center wins" { edgeLabels.placement: CENTER font.^size: 11 font.name: "Sans" }
  label "tail" { edgeLabels.placement: TAIL font.^size: 30 }
  label "undef" { edgeLabels.placement: UNDEFINED font.^size: 13 }
}
edge zeroFont : a -> a {
  label "z" { font.^size: 0 font.name: "" }
  label "z2" { font.^size: -4 }
}
edge spaced : b -> b {
  spacing.edgeLabel: 5.7
  label "s" { font.^size: 10 }
}
edge spacedLow : a -> b {
  spacing.edgeLabel: 0.5
  label "lo" { font.^size: 10 }
}
edge spacedOne : a -> b {
  spacing.edgeLabel: 1
  label "one" { font.^size: 10 edgeLabels.placement: CENTER }
  label "tail only" { font.^size: 10 edgeLabels.placement: TAIL }
}
edge escaped : b -> a {
  label "q\"b\\n\nx\u00e9" { font.^size: 10 }
}
edge headOnly : a -> b {
  label "h" { edgeLabels.placement: HEAD font.^size: 10 font.name: "Arial" }
}
