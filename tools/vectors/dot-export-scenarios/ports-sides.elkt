node a {
  layout [ size: 60, 40 ]
  nodeSize.constraints: PORTS
  port pn { layout [ position: 10, -5 size: 5, 5 ] ^port.side: NORTH label "pn" }
  port pe { layout [ position: 60, 10.5 size: 5, 5 ] ^port.side: EAST }
  port ps { layout [ position: 20.25, 40 size: 5, 5 ] ^port.side: SOUTH }
  port pw { layout [ position: -5, 20 size: 5, 5 ] ^port.side: WEST }
  port pu { layout [ position: 55, 35 size: 4, 4 ] }
}
node b {
  layout [ position: 100, 0 size: 50, 30 ]
  portConstraints: FIXED_POS
  nodeSize.constraints: "[PORTS]"
  port qn { layout [ position: 30, -3 size: 3, 3 ] ^port.side: NORTH }
  port qw { layout [ position: -3, 10 size: 3, 3 ] ^port.side: WEST }
  port qu { layout [ position: 0.5, 0.5 size: 3, 3 ] }
}
node c {
  layout [ position: 0, 100 size: 40, 40 ]
  port r { layout [ position: 18.3, -2.7 size: 4.4, 2.2 ] }
}
edge a.pe -> b.qw
edge a.ps -> c.r
edge c.r -> a
edge b -> a.pn
edge a.pu -> b.qu
