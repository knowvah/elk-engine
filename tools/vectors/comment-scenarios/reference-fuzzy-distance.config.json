{
  "includeHierarchy": true,
  "keepHeuristicsEnabledWithExplicitAttachments": false,
  "explicit": "none",
  "boundsProvider": {
    "type": "ElkGraphBoundsProvider",
    "cached": true
  },
  "filters": [],
  "matchers": [
    {
      "type": "NodeReferenceMatcher",
      "fuzzy": true,
      "maxDistance": 200
    }
  ],
  "decider": {
    "aggregator": "max",
    "lowerBoundary": 0.5,
    "included": false
  }
}
