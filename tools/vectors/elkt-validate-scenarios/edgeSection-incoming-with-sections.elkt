// @covers 235-237 (incoming shape together with incoming sections)
node a { port p }
node b
edge e: a -> b {
  layout [
    section s1 -> s2 [ start: 0,0 end: 1,1 ]
    section s2 [ incoming: a start: 1,1 end: 2,2 ]
  ]
}
edge f: a.p -> b {
  layout [
    section t1 -> t2 [ start: 0,0 end: 1,1 ]
    section t2 [ incoming: a.p start: 1,1 end: 2,2 ]
  ]
}
