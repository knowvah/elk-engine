// @covers 240-243 (outgoing shape is not a target; ElkNode and ElkPort)
node a { port p }
node b { port q }
node c
edge e: a -> b {
  layout [ outgoing: c start: 0,0 end: 1,1 ]
}
edge f: a -> b {
  layout [ outgoing: b.q start: 0,0 end: 1,1 ]
}
edge g: a -> b.q {
  layout [ outgoing: a.p start: 0,0 end: 1,1 ]
}
