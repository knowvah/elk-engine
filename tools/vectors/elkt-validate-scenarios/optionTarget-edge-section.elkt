// @covers 65, 81 (container ElkEdgeSection is no ElkGraphElement: no target or algorithm check, value checks run)
node a
node b
edge e: a -> b {
  layout [
    section s1 -> s2 [ start: 0,0 end: 1,1 direction: UP spacing.nodeNode: -1 x.unknown: 3 ]
    section s2 [ start: 1,1 end: 5,5 ^port.side: NORTH ]
  ]
}
