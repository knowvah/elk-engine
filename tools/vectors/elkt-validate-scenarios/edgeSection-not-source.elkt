// @covers 231-234 (incoming shape is not a source; ElkNode and ElkPort class names)
node a { port p }
node b { port q }
node c
edge e: a -> b {
  layout [ incoming: c start: 0,0 end: 1,1 ]
}
edge f: a -> b {
  layout [ incoming: a.p start: 0,0 end: 1,1 ]
}
edge g: a.p -> b {
  layout [ incoming: b.q start: 0,0 end: 1,1 ]
}
