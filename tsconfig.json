{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "types": ["node"],
    "paths": {
      "@knowvah/elk-engine": ["./test/public-api/candidate-index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "tools/**/*.ts"]
}
