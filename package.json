{
  "name": "@knowvah/elk-engine",
  "version": "0.0.0-development",
  "description": "Faithful TypeScript port of the Eclipse Layout Kernel (ELK) — no Java, no WASM. Oracle-verified against the Java implementation, runs in the browser.",
  "keywords": [
    "elk",
    "eclipse-layout-kernel",
    "graph",
    "layout",
    "layered",
    "diagram",
    "visualization",
    "typescript",
    "browser"
  ],
  "license": "EPL-2.0",
  "author": "Scott Seely",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "@knowvah:registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowvah/elk-engine.git"
  },
  "homepage": "https://elk-engine.knowvah.com/",
  "bugs": {
    "url": "https://github.com/knowvah/elk-engine/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "complexity": "tsx tools/complexity/check.ts",
    "melk:generate": "tsx tools/melk/generate.ts",
    "test": "vitest run",
    "coverage": "bash tools/coverage-gate/run.sh",
    "build": "npm run build:js && npm run build:types",
    "build:js": "esbuild src/index.ts --bundle --format=esm --sourcemap --outfile=dist/index.js",
    "build:types": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:brand": "node docs-site/copy-brand-assets.mjs",
    "docs:copy-goldens": "node docs-site/copy-goldens.mjs",
    "docs:copy-reports": "node docs-site/copy-reports.mjs",
    "docs:api": "npm ci --prefix tools/typedoc --no-audit --no-fund && tools/typedoc/node_modules/.bin/typedoc --options tools/typedoc/typedoc.json",
    "docs:dev": "npm run docs:brand && npm run docs:copy-goldens && npm run docs:copy-reports && npm run docs:i18n-hashes && npm run docs:api && vitepress dev docs-site",
    "docs:build": "npm run docs:brand && npm run docs:copy-goldens && npm run docs:copy-reports && npm run docs:i18n-hashes && npm run docs:api && vitepress build docs-site",
    "docs:linkcheck": "linkinator . guide/getting-started.html reference/ --config docs-site/linkinator.config.json",
    "docs:linkcheck:external": "linkinator . guide/getting-started.html reference/ --config docs-site/linkinator.external.config.json",
    "docs:i18n-status": "node scripts/docs-i18n-status.mjs",
    "docs:i18n-hashes": "node scripts/docs-i18n-status.mjs --write-hashes",
    "docs:preview": "vitepress preview docs-site",
    "release": "semantic-release",
    "publish:check": "npm run typecheck && npm run build && npm pack --dry-run",
    "pack:smoke": "tsx tools/release/pack-smoke.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@knowvah/theme": "^0.3.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "linkinator": "^8.1.0",
    "oxc-parser": "^0.154.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  },
  "volta": {
    "node": "26.3.1"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.5"
    }
  }
}
